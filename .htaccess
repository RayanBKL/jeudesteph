# ============================================================
# The Ashtray King — .htaccess Hostinger (sécurité + cache)
# ============================================================

Options -Indexes
RewriteEngine On
# (pas de RewriteBase : ce même fichier sert aussi la version de test, installée dans un sous-dossier caché)

# HTTPS forcé
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# MAINTENANCE : tant que « maintenance.on » existe à la racine, l'accueil et les pages du jeu à la racine renvoient « maintenance.html » (503).
# Ne bloquent PAS : les images/CSS/JS, admin.html, les fichiers existants, et les dossiers existants (la version de test cachée).
# Toute autre adresse inconnue (qui retomberait sur le jeu) est bloquée aussi.
ErrorDocument 503 /maintenance.html
RewriteCond %{DOCUMENT_ROOT}/maintenance.on -f
RewriteCond %{REQUEST_URI} ^/(index\.html)?$
RewriteRule ^ - [R=503,L]
RewriteCond %{DOCUMENT_ROOT}/maintenance.on -f
RewriteCond %{REQUEST_URI} !^/(maintenance\.html|maintenance\.on|admin\.html|favicon\.ico|assets/|css/|js/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=503,L]

# Jamais servis au public : dépôt git, secrets, scripts, base de données, notes de travail
RewriteRule ^(\.git|\.github|scripts|supabase|data|node_modules)(/|$) - [R=404,L]
RewriteRule (^|/)\.(?!well-known) - [R=404,L]
RewriteRule ^(CLAUDE|RECAP|README)\.md$ - [R=404,L]
RewriteRule ^supabase_schema\.sql$ - [R=404,L]
RewriteRule \.(py|sh|sql|bak|log|env|map|md)$ - [R=404,L]

# SPA fallback (chemin relatif : marche à la racine comme dans le sous-dossier de test)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.html [L]

# === EN-TÊTES DE SÉCURITÉ ===
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  # Scripts : le site lui-même + la bibliothèque Supabase (verrouillée par empreinte SRI dans index.html)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com; connect-src 'self' https://xfktspcyvfwdyuzewyni.supabase.co wss://xfktspcyvfwdyuzewyni.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# Le tableau de bord ne doit jamais apparaître dans Google
<Files "admin.html">
  Header set X-Robots-Tag "noindex, nofollow"
</Files>

# === COMPRESSION ===
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# === CACHE (les fichiers JS/CSS changent de ?v= à chaque mise à jour) ===
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
</IfModule>
